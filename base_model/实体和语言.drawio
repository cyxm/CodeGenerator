        <mxCell id="q-HN7M_W7D67pqpHvjYQ-12" value="组合" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="q-HN7M_W7D67pqpHvjYQ-11">
