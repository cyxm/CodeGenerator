        </mxCell>
        <mxCell id="icFrRc2_i2oBbtaFi4X1-10" value="抽象实体" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="1480" y="720" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="icFrRc2_i2oBbtaFi4X1-11" value="&lt;div&gt;模糊实体&lt;/div&gt;&lt;div&gt;一些抽象实体对应的直接实体并不明确,边界模糊,只能聚焦于一些特征去描述&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="880" width="280" height="80" as="geometry" />
