        <mxCell id="q-HN7M_W7D67pqpHvjYQ-13" value="实体" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="400" y="720" width="80" height="80" as="geometry" />
