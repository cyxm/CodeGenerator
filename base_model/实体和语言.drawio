        </mxCell>
        <mxCell id="mXXA81HDwAGa8J_oZ_1J-15" value="表达单元" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="720" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mXXA81HDwAGa8J_oZ_1J-16" value="" style="endArrow=none;html=1;rounded=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="mXXA81HDwAGa8J_oZ_1J-14" target="mXXA81HDwAGa8J_oZ_1J-15" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="870" y="350" as="sourcePoint" />
            <mxPoint x="920" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mXXA81HDwAGa8J_oZ_1J-17" value="" style="endArrow=none;html=1;rounded=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" parent="1" source="mXXA81HDwAGa8J_oZ_1J-14" target="mXXA81HDwAGa8J_oZ_1J-13" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="870" y="350" as="sourcePoint" />
            <mxPoint x="920" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mXXA81HDwAGa8J_oZ_1J-18" value="&lt;div&gt;语义和表达的分类:&lt;/div&gt;&lt;div&gt;1.抽象层级&lt;/div&gt;&lt;div&gt;专有语义-其他(直接语义)-抽象语义&lt;/div&gt;&lt;div&gt;专有词-其他(普通词)-抽象词&lt;/div&gt;&lt;div&gt;2.时间相关&lt;/div&gt;&lt;div&gt;静态和动态&lt;/div&gt;&lt;div&gt;3.结构和交互&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;" parent="1" vertex="1">
          <mxGeometry x="480" y="40" width="240" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="U9a-gP_SoYzBjImV3Buy" name="软件语义">
    <mxGraphModel dx="1412" dy="737" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zwSjhUTSNHt5r1pXhi_--1" value="&lt;div&gt;硬件&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.可编程机(固定硬件流程,取指令,执行指令,传输数据)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.总线结构(冯诺依曼结构,哈佛结构,其他非通用的结构)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="200" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="zwSjhUTSNHt5r1pXhi_--3" value="&lt;div&gt;操作系统&lt;/div&gt;&lt;div&gt;屏蔽硬件层的差异,并提供额外的功能&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.内存管理&lt;/div&gt;&lt;div&gt;逻辑内存(段页式,映射物理内存)&lt;/div&gt;&lt;div&gt;进程管理&lt;/div&gt;&lt;div&gt;堆栈内存管理模型(代码段,数据段,堆,栈)&lt;/div&gt;&lt;div&gt;IPC(通过内核态共享内存)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.CPU管理(线程管理)&lt;/div&gt;&lt;div&gt;流水线指令调度&lt;/div&gt;&lt;div&gt;多任务并发&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.文件系统(大容量存储硬件的数据管理)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4.I/O管理&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;5.中断和异常&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;6.权限管理&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="440" width="320" height="320" as="geometry" />
        </mxCell>
        <mxCell id="zwSjhUTSNHt5r1pXhi_--6" value="&lt;div&gt;虚拟机&lt;/div&gt;&lt;div&gt;屏蔽操作系统的差异,并提供额外的功能&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.字节码管理&lt;/div&gt;&lt;div&gt;虚拟机可以解释并运行自己的字节码&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.内存自动管理&lt;/div&gt;&lt;div&gt;自动分配和释放内存&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.类加载和名称管理&lt;/div&gt;&lt;div&gt;虚拟机保留名称,可以通过反射调用,增加可扩展性,但响应的会降低执行效率&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4.线程与同步锁&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;5.异常&lt;/div&gt;&lt;div&gt;可以非破坏性的捕获并处理异常&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;6.Native调用&lt;/div&gt;&lt;div&gt;保留对底层代码的调用方法&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="880" width="320" height="320" as="geometry" />
        </mxCell>
        <mxCell id="zwSjhUTSNHt5r1pXhi_--8" value="&lt;div&gt;浏览器&lt;/div&gt;&lt;div&gt;一种特殊的虚拟机和解释器&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.JS脚本执行&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.Web UI渲染&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.网络请求&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4.特殊的本地存储&lt;/div&gt;&lt;div&gt;localStorage,cookies&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="1320" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="TJ0hToIEeiY0GXmWugr6-3" value="&lt;div&gt;软件语义:&lt;/div&gt;&lt;div&gt;软件的语义本质上是计算机这一物理实体运行特征的认知,抽离硬件的底层运行特征,将硬件抽象为自动机模型&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="iVKW09PnfDHmBO5p8iMp-1" value="&lt;div&gt;指令集(汇编语言,机器码)&lt;/div&gt;&lt;div&gt;拥有最基础的语义,控制硬件层的运行程序&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.数据传送类&lt;/div&gt;&lt;div&gt;2.运算类&lt;/div&gt;&lt;div&gt;3.控制转移类&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" parent="1" vertex="1">
          <mxGeometry x="440" y="200" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="iVKW09PnfDHmBO5p8iMp-2" value="&lt;div&gt;操作系统API&lt;/div&gt;&lt;div&gt;对汇编层的一种重构映射,减少信息量,增加范式,使得程序更具有可控性&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.进程和线程的创建和状态管理&lt;/div&gt;&lt;div&gt;2.内存分配和释放&lt;/div&gt;&lt;div&gt;3.文件操作&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" parent="1" vertex="1">
          <mxGeometry x="440" y="440" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="9o2Lax45PIHrJYCuEolH-1" value="&lt;div&gt;虚拟机API&lt;/div&gt;&lt;div&gt;基于操作系统层的一种重构映射&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" parent="1" vertex="1">
          <mxGeometry x="440" y="880" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Uxro-yMO9At9-UMyh5KJ-2" value="&lt;div&gt;Web API&lt;/div&gt;&lt;div&gt;浏览器特殊的功能&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="440" y="1320" width="320" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="_dpjO9CfjUQIK1JU279d" name="高级语言语义">
    <mxGraphModel dx="1412" dy="737" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="piWYiHJs5690SxfmuSbS-1" value="&lt;div&gt;模块划分&lt;/div&gt;&lt;div&gt;对大型复杂的软件进行模块划分是基本操作,同时模块也包含对内存作用域和生命周期的管理&lt;/div&gt;&lt;div&gt;现有的高级语言模块划分首先是基于文件系统,便于编译器或解释器索引&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.文件层模块(基于文件系统的划分)&lt;/div&gt;&lt;div&gt;确定模块索引的根目录&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.逻辑模块&lt;/div&gt;&lt;div&gt;不同语言的逻辑模块不同,本质上都是明确模块划分和防止重名的手段&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="440" y="40" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="nwKCZ937IxME6ko5EtRX-1" value="&lt;div&gt;编译语义&lt;/div&gt;&lt;div&gt;在编译时期使用的语义,部分指令可能既影响编译也影响执行指令&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.宏指令&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.注释&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="2EPVEk81-aywpxsvqkG2-1" value="&lt;div&gt;基础数据类型&lt;/div&gt;&lt;div&gt;数据在内存中都是以位和字节的形式存在,通过定义数据的长度和类型,决定数据间不同的计算方式&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.算术类型&lt;/div&gt;&lt;div&gt;整数&lt;/div&gt;&lt;div&gt;浮点数(十进制和二进制转换时小数部分无法精确映射)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.状态类型&lt;/div&gt;&lt;div&gt;bool(最常用二元状态,对应基础存储单元-位)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.字符类型&lt;/div&gt;&lt;div&gt;通过字符集将数据映射为字符&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="360" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="agXR4GtQFaWUH-h-wd98-2" value="&lt;div&gt;基础运算&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.算术运算&lt;/div&gt;&lt;div&gt;+ - * / &amp;lt;&amp;lt; &amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.逻辑运算&lt;/div&gt;&lt;div&gt;&amp;amp; | ^ XOR &amp;lt;&amp;lt;&amp;lt; &amp;gt;&amp;gt;&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.比较运算&lt;/div&gt;&lt;div&gt;&amp;lt; &amp;gt; ==&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="440" y="360" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="agXR4GtQFaWUH-h-wd98-4" value="&lt;div&gt;基础流程&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.顺序&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.分支&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.循环&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
