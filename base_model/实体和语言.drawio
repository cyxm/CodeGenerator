        <mxCell id="q-HN7M_W7D67pqpHvjYQ-14" value="多个实体" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="680" y="720" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q-HN7M_W7D67pqpHvjYQ-15" value="&lt;div&gt;隐含实体(语境)&lt;/div&gt;&lt;div&gt;所有逻辑都有隐含实体,属于语境中的共识,要使得逻辑更加严谨,需要在逻辑语义中明确这些隐含实体&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q-HN7M_W7D67pqpHvjYQ-16" value="聚焦实体" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="400" y="880" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q-HN7M_W7D67pqpHvjYQ-17" value="隐含实体" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="680" y="880" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q-HN7M_W7D67pqpHvjYQ-18" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q-HN7M_W7D67pqpHvjYQ-16" target="q-HN7M_W7D67pqpHvjYQ-17">
