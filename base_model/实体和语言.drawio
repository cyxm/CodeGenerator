        <mxCell id="-ozyk9N5ES07P6MuCZsl-4" value="Item 3" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="-ozyk9N5ES07P6MuCZsl-1" vertex="1">
