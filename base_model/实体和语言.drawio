        </mxCell>
        <mxCell id="EJ2aE_AdS1A4rjaYWyXd-4" value="专有语义" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="JwXL0MIgkQvUZLQtpopO-1">
          <mxGeometry y="30" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="EJ2aE_AdS1A4rjaYWyXd-2" value="直接语义" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="JwXL0MIgkQvUZLQtpopO-1">
          <mxGeometry y="60" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="EJ2aE_AdS1A4rjaYWyXd-3" value="抽象语义" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="JwXL0MIgkQvUZLQtpopO-1">
          <mxGeometry y="90" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ETdjiBc7xZRC_TN6TPh8-1" value="&lt;div&gt;语义就是认知实体在语言系统中的表述&lt;/div&gt;&lt;div&gt;1.直接语义&lt;/div&gt;&lt;div&gt;由人体的感官直接认知并映射的认知实体,通常能直接对应到物理实体&lt;/div&gt;&lt;div&gt;通常是由专有语义归纳而来&lt;/div&gt;&lt;div&gt;2.抽象语义&lt;/div&gt;&lt;div&gt;由直接语义归纳而成,只聚焦可认知的部分特征&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通常专有语义是指特定的物理实体,具有唯一的空间和时间特征,对应语言表达中的专有名词,而直接语义是具有相同特征的一系列专有语义的泛指,举几个例子:&lt;/div&gt;&lt;div&gt;1.把桌上的苹果给我&lt;/div&gt;&lt;div&gt;语境:日常对话,对话的两个人在同一个房间内,且房间里只有一张桌子&lt;/div&gt;&lt;div&gt;这里苹果可以是专有语义,特指此物理实体,也可以是直接语义,我不知道苹果数量,&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="400" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
