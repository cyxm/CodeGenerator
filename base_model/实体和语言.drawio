          </mxGeometry>
        </mxCell>
        <mxCell id="icFrRc2_i2oBbtaFi4X1-1" value="&lt;div&gt;抽象逻辑(归纳逻辑)&lt;/div&gt;&lt;div&gt;对直接实体进行特征提取,形成特征信息更少的抽象实体&lt;/div&gt;&lt;div&gt;X属于Y&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="560" width="280" height="80" as="geometry" />
