        <mxCell id="yFKnU3Q6yaNPvrjwR3Xp-7" value="&lt;div&gt;生成式&lt;/div&gt;&lt;div&gt;(描述如何将语义转换为符号表达)&lt;/div&gt;" style="html=1;whiteSpace=wrap;" parent="YqtILlJTDyAc7TsJqT2Q-3" vertex="1">
