            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="icFrRc2_i2oBbtaFi4X1-4" value="直接实体" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="1200" y="560" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="icFrRc2_i2oBbtaFi4X1-5" value="抽象实体" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="1480" y="560" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="icFrRc2_i2oBbtaFi4X1-6" value="&lt;div&gt;具象逻辑(演绎逻辑)&lt;/div&gt;&lt;div&gt;对直接实体进行特征提取,形成特征信息更少的抽象实体&lt;/div&gt;&lt;div&gt;Y包含X&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="720" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="icFrRc2_i2oBbtaFi4X1-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="icFrRc2_i2oBbtaFi4X1-10" target="icFrRc2_i2oBbtaFi4X1-9">
