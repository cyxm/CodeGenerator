        <mxCell id="icFrRc2_i2oBbtaFi4X1-8" value="具象" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="icFrRc2_i2oBbtaFi4X1-7">
